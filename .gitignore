# Tunnel tokens and anything else that must never leave the host.
secrets/
*.token
.env
.env.*

# Runtime state. The suggestion box is real users' text: it belongs on the host that
# received it, never in a commit. .dockerignore already excludes all three from the
# build context; this is the same list for the repository.
data/
*.jsonl

node_modules/
*.log

# Build artifacts. The extension zip is produced by extension/pack.mjs and belongs on a
# release, not in the tree: a binary in git drifts from the source it was built from.
dist/
